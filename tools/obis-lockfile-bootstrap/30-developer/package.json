{
  "name": "@obis/developer-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "obis": "./dist-cli/cli/obis.js",
    "obis-extension": "./dist-cli/cli/extension-release.js"
  },
  "scripts": {
    "dev:web": "vite --config web/vite.config.ts --host 127.0.0.1 --port 4320",
    "dev:mcp": "tsx server/mcp-http.ts",
    "dev:cli": "tsx cli/obis.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "build:cli": "tsc -p tsconfig.cli.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.cli.json --noEmit",
    "smoke:cli": "node dist-cli/cli/obis.js --help"
  },
  "dependencies": {
    "@modelcontextprotocol/fastify": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fastify": "^5.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^7.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0"
  }
}
