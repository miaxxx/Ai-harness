{
  "name": "@deepseek-ai/dsh-vscode",
  "displayName": "DeepSeek Harness",
  "description": "VS Code ACP client for a standalone DeepSeek Harness Runtime",
  "version": "0.1.1-rc.2",
  "publisher": "deepseek-ai",
  "license": "MIT",
  "type": "module",
  "main": "./dist/extension.cjs",
  "engines": {
    "vscode": "^1.95.0"
  },
  "activationEvents": [
    "onCommand:dsh.createSession",
    "onCommand:dsh.openSession",
    "onCommand:dsh.prompt",
    "onCommand:dsh.closeSession"
  ],
  "contributes": {
    "commands": [
      {
        "command": "dsh.createSession",
        "title": "DeepSeek Harness: Create Session"
      },
      {
        "command": "dsh.openSession",
        "title": "DeepSeek Harness: Open Durable Session"
      },
      {
        "command": "dsh.prompt",
        "title": "DeepSeek Harness: Prompt Active Session"
      },
      {
        "command": "dsh.closeSession",
        "title": "DeepSeek Harness: Close Active Session"
      }
    ],
    "configuration": {
      "title": "DeepSeek Harness",
      "properties": {
        "dsh.runtimeCommand": {
          "type": "string",
          "description": "Executable for the standalone ACP Runtime. Required before using Harness commands."
        },
        "dsh.runtimeArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Arguments passed verbatim to the ACP Runtime executable."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -b && tsdown"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "0.25.1",
    "@deepseek-ai/dsh-acp-client": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/vscode": "^1.95.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  }
}
