{
  "name": "@deepseek-ai/dsh-desktop",
  "description": "macOS Electron technical preview over an independently supervised standalone ACP Runtime",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "apps/desktop"
  },
  "type": "module",
  "main": "dist/main.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b && tsdown && vite build",
    "dist:mac": "pnpm run build && tsx ../../scripts/build-desktop-runtime.ts && electron-builder --mac dir --publish never",
    "verify:dist": "tsx ../../scripts/verify-desktop-dist.ts",
    "start": "electron ."
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "0.25.1",
    "@deepseek-ai/dsh-acp-client": "workspace:^",
    "@deepseek-ai/dsh-mcp-user-config": "workspace:^",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@vitejs/plugin-react": "^4.0.0",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "unrun": "^0.3.1",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "ai.deepseek.harness.desktop",
    "productName": "DeepSeek Harness",
    "asar": true,
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "runtime-dist",
        "to": "runtime"
      }
    ],
    "directories": {
      "output": "dist-electron"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "identity": null,
      "target": [
        "dir"
      ]
    }
  },
  "license": "MIT"
}
